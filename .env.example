# DOC_01 §3 — copy to `.env` and fill in. Every variable below is read by
# app/config.py.

# Postgres connection (matches docker-compose.yml credentials).
DATABASE_URL=postgresql+asyncpg://eduverse:eduverse@localhost:5432/eduverse

# Anthropic API key (required in ENV=study; no LLM calls happen this phase).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# YouTube Data API v3 key — required to run the DOC_03 curation pipeline.
YOUTUBE_API_KEY=

# Voyage AI key for voyage-3 embeddings (DOC_03). Blank => offline embedder.
VOYAGE_API_KEY=

# Model selection (Scribe uses the reasoning model; DOC_03 §4.2).
ANTHROPIC_MODEL_REASONING=claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-sonnet-4-6

# Embeddings: voyage (default) | local (sentence-transformers) | hash (offline).
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# Logging.
LOG_LEVEL=INFO
LOG_FILE=./logs/events.jsonl

# Cache every Claude response for reproducible replay during analysis (DOC_08
# §8). Keep on for the study; disable only for local experiments wanting variety.
LLM_CACHE_ENABLED=true

# Admin token guarding content preview/regenerate and the DOC_08 export
# endpoints (POST /admin/export, /admin/export-all).
ADMIN_TOKEN=

# Browser origins allowed to call the API (the participant frontend). Comma-
# separated; add the deployed frontend URL here for the pilot.
CORS_ORIGINS=http://localhost:3000

# Environment: dev | test | study (no prod — research prototype).
ENV=dev
